#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

#ifdef SNIPLITE_CLI
1 RT_MANIFEST "cli.manifest"
#define FILE_DESC "sniplite command line"
#define FILE_NAME "sniplite.com"
#else
1 RT_MANIFEST "sniplite.manifest"
#define FILE_DESC "sniplite screenshot tool"
#define FILE_NAME "sniplite.exe"

IDI_APP ICON "sniplite.ico"

/* The dialogs give the places and sizes only. Every text is set when a dialog opens,
 * from src/lang_text.h, and the font named here is replaced by the font of the
 * language in use (src/lang.c). Controls are wide and tall enough for the longest
 * language. */

/* Preferences: compact window, tabs on top, one page per area. */
IDD_SETTINGS DIALOGEX 0, 0, 238, 210
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP, 6, 6, 226, 198
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 220, 178
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    AUTOCHECKBOX    "", IDC_AUTOSTART, 8, 8, 204, 12, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_TRAY, 8, 22, 204, 12, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_PIN_TOP, 8, 36, 204, 12, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_PIN_TEXT, 8, 50, 204, 12, WS_TABSTOP
    LTEXT           "", IDC_LANG_LABEL, 8, 71, 72, 10
    COMBOBOX        IDC_LANG, 82, 69, 130, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_THEME_LABEL, 8, 88, 72, 10
    COMBOBOX        IDC_THEME, 82, 86, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "", IDC_INI_GROUP, 8, 105, 204, 48
    LTEXT           "", IDC_PATH_LABEL, 16, 118, 30, 10
    EDITTEXT        IDC_INI_PATH, 48, 116, 156, 13, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "", IDC_OPEN_DIR, 16, 133, 72, 15
    PUSHBUTTON      "", IDC_OPEN_INI, 154, 133, 50, 15
    CONTROL         "", IDC_HELPBTN, "Button", BS_OWNERDRAW | WS_TABSTOP, 8, 164, 13, 13
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 163, 60, 15
END

IDD_PAGE_CAPTURE DIALOGEX 0, 0, 220, 178
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_MODE_LABEL, 8, 10, 40, 10
    AUTORADIOBUTTON "", IDC_DXGI, 50, 9, 74, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_GDI, 128, 9, 84, 12
    AUTOCHECKBOX    "", IDC_EXIT_ASK, 8, 32, 204, 12, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_ALSO_SAVE, 8, 46, 204, 12, WS_TABSTOP
    LTEXT           "", IDC_DETECT_LABEL, 8, 68, 72, 10
    COMBOBOX        IDC_DETECT, 82, 66, 130, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 8, 88, 204, 1
    LTEXT           "", IDC_SAVE_LABEL, 8, 96, 150, 10
    EDITTEXT        IDC_SAVE_DIR, 8, 107, 150, 13, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "", IDC_SAVE_PICK, 162, 106, 50, 15
    LTEXT           "", IDC_NAME_LABEL, 8, 131, 72, 10
    COMBOBOX        IDC_NAME, 82, 129, 130, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_FPS_LABEL, 8, 147, 52, 10
    COMBOBOX        IDC_FPS, 62, 145, 52, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_COLOURS_LABEL, 120, 147, 52, 10
    COMBOBOX        IDC_COLOURS, 174, 145, 38, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 163, 60, 15
END

IDD_PAGE_HOTKEYS DIALOGEX 0, 0, 220, 178
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_HK_LABEL1, 8, 10, 72, 10
    CONTROL         "", IDC_HK_FIELD1, "sniplite.hotkey", WS_TABSTOP, 82, 7, 100, 14
    CONTROL         "", IDC_HK_CLEAR1, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 8, 12, 12
    CONTROL         "", IDC_HK_STATE1, "Static", SS_OWNERDRAW, 201, 8, 12, 12
    LTEXT           "", IDC_HK_LABEL2, 8, 27, 72, 10
    CONTROL         "", IDC_HK_FIELD2, "sniplite.hotkey", WS_TABSTOP, 82, 24, 100, 14
    CONTROL         "", IDC_HK_CLEAR2, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 25, 12, 12
    CONTROL         "", IDC_HK_STATE2, "Static", SS_OWNERDRAW, 201, 25, 12, 12
    LTEXT           "", IDC_HK_LABEL3, 8, 44, 72, 10
    CONTROL         "", IDC_HK_FIELD3, "sniplite.hotkey", WS_TABSTOP, 82, 41, 100, 14
    CONTROL         "", IDC_HK_CLEAR3, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 42, 12, 12
    CONTROL         "", IDC_HK_STATE3, "Static", SS_OWNERDRAW, 201, 42, 12, 12
    LTEXT           "", IDC_HK_LABEL4, 8, 61, 72, 10
    CONTROL         "", IDC_HK_FIELD4, "sniplite.hotkey", WS_TABSTOP, 82, 58, 100, 14
    CONTROL         "", IDC_HK_CLEAR4, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 59, 12, 12
    CONTROL         "", IDC_HK_STATE4, "Static", SS_OWNERDRAW, 201, 59, 12, 12
    LTEXT           "", IDC_HK_LABEL5, 8, 78, 72, 10
    CONTROL         "", IDC_HK_FIELD5, "sniplite.hotkey", WS_TABSTOP, 82, 75, 100, 14
    CONTROL         "", IDC_HK_CLEAR5, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 76, 12, 12
    CONTROL         "", IDC_HK_STATE5, "Static", SS_OWNERDRAW, 201, 76, 12, 12
    LTEXT           "", IDC_HK_LABEL6, 8, 95, 72, 10
    CONTROL         "", IDC_HK_FIELD6, "sniplite.hotkey", WS_TABSTOP, 82, 92, 100, 14
    CONTROL         "", IDC_HK_CLEAR6, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 93, 12, 12
    CONTROL         "", IDC_HK_STATE6, "Static", SS_OWNERDRAW, 201, 93, 12, 12
    LTEXT           "", IDC_HINT, 8, 110, 204, 17
    AUTOCHECKBOX    "", IDC_HK_FULLSCREEN, 8, 130, 204, 12, WS_TABSTOP
    LTEXT           "", IDC_HK_APPS_LABEL, 8, 148, 140, 10
    PUSHBUTTON      "", IDC_HK_APPS, 152, 145, 60, 15
    PUSHBUTTON      "", IDC_BUILTIN, 8, 163, 60, 15
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 163, 60, 15
END

/* Asked before a capture with a selection is left: where the mouse is. */
IDD_LEAVE DIALOGEX 0, 0, 176, 64
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTERMOUSE | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_L_TEXT, 10, 10, 156, 10
    AUTOCHECKBOX    "", IDC_L_ASK, 10, 26, 156, 12, WS_TABSTOP
    DEFPUSHBUTTON   "", IDOK, 58, 43, 52, 15
    PUSHBUTTON      "", IDCANCEL, 114, 43, 52, 15
END

IDD_SHORTCUTS DIALOGEX 0, 0, 252, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 7, 7, 238, 216
    DEFPUSHBUTTON   "", IDOK, 188, 229, 57, 15
END

IDD_APPS DIALOGEX 0, 0, 256, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER |
                    LVS_EDITLABELS | WS_BORDER | WS_TABSTOP, 7, 7, 170, 134
    PUSHBUTTON      "", IDC_APPS_NEW, 184, 7, 65, 15
    PUSHBUTTON      "", IDC_APPS_EDIT, 184, 26, 65, 15
    PUSHBUTTON      "", IDC_APPS_BROWSE, 184, 45, 65, 15
    PUSHBUTTON      "", IDC_APPS_DELETE, 184, 64, 65, 15
    PUSHBUTTON      "", IDC_APPS_TEXT, 184, 126, 65, 15
    DEFPUSHBUTTON   "", IDOK, 115, 148, 65, 15
    PUSHBUTTON      "", IDCANCEL, 184, 148, 65, 15
END

IDD_APPS_TEXT DIALOGEX 0, 0, 256, 62
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_APPS_TEXT_LABEL, 7, 8, 242, 10
    EDITTEXT        IDC_APPS_TEXT_EDIT, 7, 20, 242, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 115, 40, 65, 15
    PUSHBUTTON      "", IDCANCEL, 184, 40, 65, 15
END

IDD_PAGE_UPDATE DIALOGEX 0, 0, 220, 178
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_U_VERSION, 8, 10, 204, 10
    PUSHBUTTON      "", IDC_U_CHECK, 8, 26, 60, 15
    LTEXT           "", IDC_U_STATUS, 74, 29, 138, 10
    PUSHBUTTON      "", IDC_U_INSTALL, 8, 46, 60, 15
    AUTOCHECKBOX    "", IDC_U_AUTO, 8, 70, 204, 12, WS_TABSTOP
    LTEXT           "", IDC_HINT, 8, 86, 204, 20
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 163, 60, 15
END

IDD_PAGE_OCR DIALOGEX 0, 0, 220, 178
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_O_STATE, 8, 10, 204, 10
    PUSHBUTTON      "", IDC_O_INSTALL, 8, 26, 110, 15
    PUSHBUTTON      "", IDC_O_REMOVE, 124, 26, 60, 15
    CONTROL         "", IDC_O_BAR, "msctls_progress32", 0, 8, 47, 204, 7
    LTEXT           "", IDC_O_STATUS, 8, 58, 204, 10
    LTEXT           "", IDC_HINT, 8, 74, 204, 62
END

IDD_PAGE_ABOUT DIALOGEX 0, 0, 220, 178
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    ICON            IDI_APP, -1, 8, 10, 20, 20
    LTEXT           "", IDC_VERSION, 38, 10, 174, 12
    LTEXT           "", IDC_TAGLINE, 38, 25, 174, 10
    LTEXT           "", IDC_LICENSE, 38, 39, 174, 10
    PUSHBUTTON      "", IDC_PROJECT, 8, 163, 140, 15
END
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,5,1,0
PRODUCTVERSION 1,5,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", FILE_DESC
      VALUE "FileVersion", "1.5.1"
      VALUE "ProductName", "sniplite"
      VALUE "ProductVersion", "1.5.1"
      VALUE "OriginalFilename", FILE_NAME
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
